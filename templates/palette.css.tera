---
whiskers:
  version: "^2.9.0"
  filename: "public/css/palette.css"
# The page uses a subset of the 26 palette colors. Add a name here and it
# appears in every flavor block.
colors:
  - base
  - mantle
  - crust
  - text
  - subtext1
  - subtext0
  - overlay2
  - surface0
  - surface1
  - surface2
  - blue
  - lavender
  - mauve
---
/* Generated by whiskers from templates/palette.css.tera -- do not edit. */

{% for _, flavor in flavors -%}
:root[data-flavor="{{ flavor.identifier }}"] {
{%- for name in colors %}
  --{{ name }}: #{{ flavor.colors[name].hex }};
{%- endfor %}
}
{% endfor %}
